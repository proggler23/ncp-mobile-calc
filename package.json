{
  "name": "ncp-mobile-calc",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "lint": "eslint .",
    "typecheck": "tsc -b --noEmit",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "golden:capture": "node scripts/ncp-golden/capture.mjs",
    "engine:browser-verify": "node scripts/ncp-golden/browser-verify.mjs",
    "format": "prettier --write .",
    "build:data": "tsx scripts/build-data/index.ts",
    "typecheck:data": "tsc -p scripts/build-data/tsconfig.json",
    "build:bridge": "tsx scripts/build-bridge/index.ts",
    "build:assets": "npm run build:data && npm run build:bridge",
    "typecheck:bridge": "tsc -p scripts/build-bridge/tsconfig.json"
  },
  "dependencies": {
    "idb": "^8.0.4",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@pkmn/data": "^0.11.0",
    "@pkmn/dex": "^0.11.0",
    "@playwright/test": "^1.65.0",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "eslint": "^10.14.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react-hooks": "^7.1.1",
    "fake-indexeddb": "^6.2.8",
    "globals": "^17.14.0",
    "jsdom": "^31.0.0",
    "prettier": "^3.10.1",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.2",
    "vite": "^8.3.8",
    "vite-plugin-pwa": "^2.0.0",
    "vitest": "^5.1.0"
  }
}
